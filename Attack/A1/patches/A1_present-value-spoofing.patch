+/*
+ * A1 low-intensity in-band value spoof for DIN 70121 (see iso_server.cpp for the
+ * full rationale). ISO 15118-2 is the primary path in config-sil-dc-ocpp201; this
+ * mirrors the same rewrite on the DIN CurrentDemandRes for completeness.
+ */
+static void a1_spoof_din_pv(struct din_PhysicalValueType* pv, const char* which) {
+    static int inited = 0, enabled = 0;
+    static double factor = 1.0;
+    static char target[24] = "present_current";
+    if (!inited) {
+        inited = 1;
+        const char* e = getenv("A1_ATTACK");
+        enabled = (e != NULL) && (e[0] == '1' || e[0] == 't' || e[0] == 'T' || e[0] == 'y' || e[0] == 'Y');
+        const char* f = getenv("A1_FACTOR");
+        if (f != NULL) factor = atof(f);
+        const char* t = getenv("A1_TARGET");
+        if (t != NULL) { strncpy(target, t, sizeof(target) - 1); target[sizeof(target) - 1] = '\0'; }
+    }
+    if (!enabled || factor == 1.0) return;
+    if (strcmp(target, "both") != 0 && strcmp(target, which) != 0) return;
+    long forged = lround((double)pv->Value * factor);
+    dlog(DLOG_LEVEL_INFO, "[A1-ATTACK] DIN %s spoof: %d -> %ld (factor=%.4f, mult=%d)",
+         which, (int)pv->Value, forged, factor, (int)pv->Multiplier);
+    pv->Value = (int)forged;
+}
