         res->MeterInfo.MeterReading = conn->ctx->meter_info.meter_reading;
+        {
+            int a1_en, a1_c, a1_v, a1_e, a1_vinv;
+            double a1_k;
+            a1_read_cfg(&a1_en, &a1_k, &a1_c, &a1_v, &a1_e, &a1_vinv);
