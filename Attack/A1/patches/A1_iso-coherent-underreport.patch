+/*
+ * A1 coherent ISO under-report (cross-protocol boundary attack).
+ *
+ * A compromised charging station under-reports the metering values it sends to
+ * the EV over ISO 15118-2 (EVSEPresentCurrent and MeterInfo.MeterReading), while
+ * the power meter -- and therefore the OCPP MeterValues sent to the CSMS -- keep
+ * reporting the true values. The forgery is designed so that no SINGLE channel
+ * can flag it, only an ISO<->OCPP cross-check can:
+ *   - DOWN direction: present <= target reads as normal current derating, so the
+ *     ISO present-vs-target relation is not violated (present > target would be).
+ *   - COHERENT: present current and cumulative energy are scaled by the SAME
+ *     factor k (voltage held), so power = I*V and energy = integral(power) stay
+ *     internally consistent within ISO (the meter reading matches the integral
+ *     of the reported present power).
+ *   - IN-RANGE: k near 1 (default 0.8) keeps the forged value inside the normal
+ *     per-session distribution, so it is not a magnitude outlier.
+ * The result is invisible to ISO-only and to OCPP-only detection, and only the
+ * ISO<->OCPP value correspondence (rules RV04 for current, an energy-consistency
+ * rule for MeterReading) reveals it. No extra V2G messages are emitted, so
+ * message counts are unchanged (no injection/count confound).
+ *
+ * Runtime config (env, read once):
+ *   A1_ATTACK=1                      enable
+ *   A1_FACTOR=0.8                    scale factor k (<1 = under-report)
+ *   A1_TARGET=coherent|current|voltage|energy|current,energy   (default coherent
+ *                                    = current + energy, voltage held)
+ * Because EVerest does not republish these res values on its MQTT bus, the forged
+ * values are also emitted as "[A1-ATTACK] ISO ..." log lines for the collector.
+ */
+static void a1_read_cfg(int* enabled, double* k, int* do_c, int* do_v, int* do_e, int* do_vinv) {
+    static int inited = 0, en = 0, dc = 0, dv = 0, de = 0, dvi = 0;
+    static double kk = 1.0;
+    if (!inited) {
+        inited = 1;
+        const char* e = getenv("A1_ATTACK");
+        en = (e != NULL) && (e[0] == '1' || e[0] == 't' || e[0] == 'T' || e[0] == 'y' || e[0] == 'Y');
+        const char* f = getenv("A1_FACTOR");
+        kk = (f != NULL) ? atof(f) : 1.0;
+        const char* t = getenv("A1_TARGET");
+        const char* tg = (t != NULL) ? t : "coherent";
+        if (strcmp(tg, "coherent") == 0) {
+            dc = 1; de = 1; /* current + energy, voltage held */
+        } else if (strstr(tg, "power_preserving") != NULL || strstr(tg, "iv_redist") != NULL) {
+            /* power-preserving I-V redistribution: present current *k (down) and present
+               voltage /k (up) so the REPORTED power I*V (and energy) is unchanged. No
+               single channel and no power/energy check sees it; only the ISO<->OCPP
+               per-quantity comparison (RV04 current, RV03 voltage) reveals it. */
+            dc = 1; dvi = 1;
+        } else {
+            dc = (strstr(tg, "current") != NULL);
+            dv = (strstr(tg, "voltage") != NULL);
+            de = (strstr(tg, "energy") != NULL);
+        }
+    }
+    *enabled = en; *k = kk; *do_c = dc; *do_v = dv; *do_e = de; *do_vinv = dvi;
+}
